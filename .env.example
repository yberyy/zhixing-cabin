# Agent 模型 Provider 配置（全部可选，默认 rules，无需任何密钥即可运行）
# npm.cmd run dev 当前不自动读取 .env；可在 PowerShell 中设置 $env:变量后启动。
# 使用支持 --env-file 的 Node 时，可显式运行 node --env-file=.env server/index.mjs。
# 修改配置后必须停止旧服务并重启。不要将真实 Key 提交到仓库或发到聊天中。
# DeepSeek 也可双击 start-deepseek.cmd，或执行 npm.cmd run start:deepseek；专用启动器以本机 .env 为准。
# Docker Compose 会读取根目录 .env 做变量替换，显式传入 compose.yaml 中声明的变量。
# Docker 修改变量后执行 docker compose up -d --force-recreate；restart 不会应用新环境。
#
# AI_PROVIDER=rules   使用确定性规则引擎（默认，推荐离线/演示）
# AI_PROVIDER=local   调用本地 OpenAI 兼容端点，需设置 LOCAL_MODEL_URL
# AI_PROVIDER=openai  调用 OpenAI 兼容接口，需设置 OPENAI_API_KEY
AI_PROVIDER=rules

# AI_PROVIDER=local 时使用
# LOCAL_MODEL_URL 同样要求完整 Chat Completions 请求端点。
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=

# AI_PROVIDER=openai 时使用（仅在服务端读取，绝不写入前端）
# 只有 Key 而 AI_PROVIDER 仍为 rules 时，不会调用模型。
OPENAI_API_KEY=
OPENAI_MODEL=
# 这里需要完整 Chat Completions 端点，例如 https://api.openai.com/v1/chat/completions
OPENAI_BASE_URL=

# DeepSeek 使用同一个兼容适配器，不需要 OpenAI 账户；替换上面的配置，不要重复赋值：
# AI_PROVIDER=openai
# OPENAI_API_KEY=你的 DeepSeek Key（仅填写在本机 .env，不要填写在此模板中）
# OPENAI_MODEL=deepseek-flash
# OPENAI_BASE_URL=https://api.deepseek.com/chat/completions
# MODEL_TIMEOUT_MS=120000

# 单次模型请求超时（毫秒），整数 1..300000；未设置或非法值回退 8000。
# DeepSeek 等远端模型建议先设为 120000；超时仍会明确降级为 rules。
MODEL_TIMEOUT_MS=8000

# 每次 Agent 调用的可见耗时（毫秒），用于观察「运行中」状态
AGENT_STEP_DELAY_MS=140

# 仅 Docker Compose 使用：宿主机访问端口，容器内部固定 4173。
# 默认 4181，避开 npm 开发服务的 4173。只允许本机访问。
DOCKER_PORT=4181
